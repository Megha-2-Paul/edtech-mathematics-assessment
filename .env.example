# Copy this file to .env and fill in your local MySQL credentials.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edtech_assessment
DB_USER=root
DB_PASSWORD=change_me

# Optional: overrides the DB_* settings above.
# DATABASE_URL=mysql+pymysql://root:change_me@127.0.0.1:3306/edtech_assessment?charset=utf8mb4

# Local development/testing only.
# TESTING_MODE=1 allows the same browser to retake completed/expired tests.
# An active attempt is still resumed on refresh and keeps its original timer.
TESTING_MODE=1

# Load the built-in interface demo test/questions for local testing.
LOAD_DEMO_DATA=1

# Hosted testing environment secrets/services.
# Set these in Render; do not commit real values.
SECRET_KEY=generate_a_long_random_value
TEACHER_ACCESS_USERNAME=teacher
TEACHER_ACCESS_PASSWORD=choose_a_temporary_password
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
